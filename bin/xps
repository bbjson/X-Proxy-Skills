#!/usr/bin/env bash
# xps —— X-Proxy-Skills 入口
# 兼容符号链接安装（~/bin/xps -> repo/bin/xps）：先解析真实路径，再找 ../scripts。
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in
    /*) ;;
    *) src="$dir/$src" ;;
  esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"
target="$here/../scripts/xps.py"

if [ ! -f "$target" ]; then
  echo "xps: 找不到 $target（仓库结构被移动了？）" >&2
  exit 1
fi

py="${XPS_PYTHON:-}"
if [ -z "$py" ]; then
  for c in python3 python; do
    if command -v "$c" >/dev/null 2>&1; then py="$c"; break; fi
  done
fi
if [ -z "$py" ]; then
  echo "xps: 需要 python3（>=3.9）" >&2
  exit 1
fi
exec "$py" "$target" "$@"
